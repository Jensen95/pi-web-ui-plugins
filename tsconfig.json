{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		"types": ["node"]
	},
	"include": [
		"plugins/*/src/**/*.ts",
		"plugins/page-picker/extension/src/**/*.ts",
		"tests/**/*.ts",
		"scripts/**/*.ts",
		"vitest.config.ts"
	]
}
