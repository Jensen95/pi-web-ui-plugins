# Dependencies
node_modules/

# Build artifacts
dist/
.vitest/

# Release and OS files
release/
.DS_Store

# pi agent data
.pi/
.pi-web/

# Per-plugin runtime dependencies (installed on demand by the host)
plugins/*/node_modules/

# Per-plugin runtime data (user data, never committed)
plugins/*/storage/

# ---------------------------------------------------------------------------
# Generated plugin artifacts.
#
# Nothing built is committed: pi-web-ui >= 0.86 installs these plugins from
# source with `install --build`, running each manifest's own build block in an
# isolated temporary directory.
# ---------------------------------------------------------------------------
plugins/*/index.mjs
plugins/*/client/entry.mjs
plugins/*/client/vendor/
