# Dependencies
node_modules/

# Build artifacts
dist/

# OS files
.DS_Store

# pi agent data
.pi/
.pi-web/

# Per-plugin runtime dependencies (installed on demand by the host)
plugins/*/node_modules/

# Per-plugin runtime data (user data, never committed)
plugins/*/storage/

# ---------------------------------------------------------------------------
# Generated plugin artifacts.
#
# Most plugin entries are rebuilt in CI and remain ignored. image-toolkit is the
# repo-local install exception: its runnable entries and runtime modules are
# intentionally tracked so GitHub subdirectory installs work without a build.
# ---------------------------------------------------------------------------
plugins/*/index.mjs
plugins/*/client/entry.mjs
plugins/*/client/vendor/
!plugins/image-toolkit/index.mjs
!plugins/image-toolkit/client/
!plugins/image-toolkit/client/entry.mjs
!plugins/image-toolkit/client/*.mjs
