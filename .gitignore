# Dependencies
node_modules/

# Build artifacts
dist/

# Release and OS files
release/
.DS_Store

# pi agent data
.pi/
.pi-web/

# Per-plugin runtime dependencies (installed on demand by the host)
plugins/*/node_modules/

# Per-plugin runtime data (user data, never committed)
plugins/*/storage/

# ---------------------------------------------------------------------------
# Generated plugin artifacts.
#
# catalog-sync is the tracked bootstrap; it clones this repo, builds it and
# installs the generated plugin directories. Keep every other build output out
# of source-only plugin directories and release commits.
# ---------------------------------------------------------------------------
plugins/*/index.mjs
plugins/*/client/entry.mjs
plugins/*/client/vendor/
!plugins/catalog-sync/client/entry.mjs
